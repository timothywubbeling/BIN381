              }
            ],
            "formatString": "#,0.00"
          },
          {
            "name": "Outcome",
            "type": "calculated",
            "expression": "IF(powerbi_households[AtRisk] = 1, \"At risk\", \"Not at risk\")",
            "isDataTypeInferred": true,
            "summarizeBy": "none",
            "lineageTag": "36b33ef9-56d2-c092-1e22-e618987d7771",
            "annotations": [
              {
                "name": "SummarizationSetBy",
                "value": "Automatic"
              }
            ],
            "dataType": "string"
          },
          {
            "name": "Referral",
            "type": "calculated",
            "expression": "IF(powerbi_households[ReferForReview] = 1, \"Referred for follow-up\", \"Not referred\")",
            "isDataTypeInferred": true,
            "summarizeBy": "none",
            "lineageTag": "59282260-a4b9-b1a2-6e50-16189fc66c66",
            "annotations": [
              {
                "name": "SummarizationSetBy",
                "value": "Automatic"
              }
            ],
            "dataType": "string"
          },
          {
            "name": "Score band sort",
            "type": "calculated",
            "expression": "FLOOR(powerbi_households[ModelProbability] * 20, 1)",
            "isDataTypeInferred": true,
            "summarizeBy": "none",
            "lineageTag": "c69db993-7849-9dcf-7fa1-7bf525cf81ce",
            "annotations": [
              {
                "name": "SummarizationSetBy",
                "value": "Automatic"
              }
            ]
          },
          {
            "name": "Score band",
            "type": "calculated",
            "expression": "VAR b = FLOOR(powerbi_households[ModelProbability] * 20, 1) / 20 RETURN FORMAT(b, \"0.00\") & \" to \" & FORMAT(b + 0.05, \"0.00\")",
            "isDataTypeInferred": true,
            "summarizeBy": "none",
            "lineageTag": "39e5a80b-f0d4-cf7b-a9be-129e3eb2c0f0",
            "annotations": [
              {
                "name": "SummarizationSetBy",
                "value": "Automatic"
              }
            ],
            "dataType": "string",
            "sortByColumn": "Score band sort"
          },
          {
            "name": "Income vs a year ago sort",
            "type": "calculated",
            "expression": "IFERROR(VALUE(LEFT(powerbi_households[IncomeChange], 1)), 9)",
            "isDataTypeInferred": true,
            "summarizeBy": "none",
            "lineageTag": "e11afd46-521d-c4d9-9ce4-ece40479159b",
            "annotations": [
              {
                "name": "SummarizationSetBy",
                "value": "Automatic"
              }
            ]
          },
          {
            "name": "Income vs a year ago",
            "type": "calculated",
            "expression": "SWITCH(LEFT(powerbi_households[IncomeChange], 1), \"1\", \"Much higher\", \"2\", \"A little higher\", \"3\", \"About the same\", \"4\", \"A little lower\", \"5\", \"Much lower\", \"Not stated\")",
            "isDataTypeInferred": true,
            "summarizeBy": "none",
            "lineageTag": "c595b1c5-fca3-4d3c-ec32-9dfae5b9e111",
            "annotations": [
              {
                "name": "SummarizationSetBy",
                "value": "Automatic"
              }
            ],
            "dataType": "string",
            "sortByColumn": "Income vs a year ago sort"
          }
        ],
        "partitions": [
          {
            "name": "powerbi_households",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Compressed = Binary.FromText(\"\", BinaryEncoding.Base64),",
                "    Source = Csv.Document(Binary.Decompress(Compressed, Compression.GZip), [Delimiter = \",\", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),",
                "    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),",
                "    Typed = Table.TransformColumnTypes(Promoted, {{\"HouseholdKey\", Int64.Type}, {\"Split\", type text}, {\"Province\", type text}, {\"ProvinceCode\", Int64.Type}, {\"Settlement\", type text}, {\"HouseholdSize\", Int64.Type}, {\"SizeBand\", type text}, {\"MonthlyIncome\", type number}, {\"IncomeBand\", type text}, {\"IncomeChange\", type text}, {\"Electricity\", type text}, {\"GrantRecipients\", Int64.Type}, {\"GrantBand\", type text}, {\"ToiletCode\", Int64.Type}, {\"ToiletType\", type text}, {\"FI_Score\", Int64.Type}, {\"Tier\", type text}, {\"AtRisk\", Int64.Type}, {\"Severe\", Int64.Type}, {\"ModelProbability\", type number}, {\"ReferForReview\", Int64.Type}, {\"HouseholdWeight\", type number}}, \"en-US\")",
                "in",
                "    Typed"
              ]
            }
          }
        ],
        "measures": [
          {
            "name": "Households in sample",
            "expression": "COUNTROWS(powerbi_households)",
            "lineageTag": "6e80a1cc-bfde-b168-1e6e-8ec553d0cae9",
            "formatString": "#,0",
            "description": "Households in the current selection.",
            "displayFolder": "1 Counts"
          },
          {
            "name": "Households",
            "expression": "COUNTROWS(powerbi_households)",
            "lineageTag": "fe4285ce-0cbc-df36-2cc5-fb392870bd45",
            "formatString": "#,0",
            "displayFolder": "1 Counts"
          },
          {
            "name": "Test households",
            "expression": "CALCULATE(COUNTROWS(powerbi_households), powerbi_households[Split] = \"Test\")",
            "lineageTag": "95022d6d-edf0-2afe-9d0d-91342ca1fc2e",
            "formatString": "#,0",
            "displayFolder": "1 Counts"
          },
          {
            "name": "Estimated households at risk",
            "expression": "SUMX(powerbi_households, powerbi_households[AtRisk] * powerbi_households[HouseholdWeight])",
            "lineageTag": "14ec6fc6-4dd5-ea9f-c5d2-b33d4d1db3f0",
            "formatString": "#,0",
            "description": "Survey-weighted population estimate.",
            "displayFolder": "1 Counts"
          },
          {
            "name": "At-risk share (weighted)",
            "expression": "DIVIDE(SUMX(powerbi_households, powerbi_households[AtRisk] * powerbi_households[HouseholdWeight]), SUM(powerbi_households[HouseholdWeight]))",
            "lineageTag": "410310dc-e9ff-13ba-5a12-f9279651965d",
            "formatString": "0.0%",
            "description": "Share of households at risk, weighted by HouseholdWeight.",
            "displayFolder": "2 Prevalence"
          },
          {
            "name": "At-risk share (unweighted)",
            "expression": "DIVIDE(SUM(powerbi_households[AtRisk]), COUNTROWS(powerbi_households))",
            "lineageTag": "e402e1ca-f845-33dc-b77c-a3c08fc5a874",
            "formatString": "0.0%",
            "displayFolder": "2 Prevalence"
          },
          {
            "name": "Severe share (weighted)",
            "expression": "DIVIDE(SUMX(powerbi_households, powerbi_households[Severe] * powerbi_households[HouseholdWeight]), SUM(powerbi_households[HouseholdWeight]))",
            "lineageTag": "88b3fad0-5311-6f29-62c0-9902b6e40c27",
            "formatString": "0.0%",
            "displayFolder": "2 Prevalence"
          },
          {
            "name": "Referred share",
            "expression": "DIVIDE(SUM(powerbi_households[ReferForReview]), COUNTROWS(powerbi_households))",
            "lineageTag": "1f72bbe8-ed81-707c-d5b5-141fdbf76831",
            "formatString": "0.0%",
            "description": "Share referred across all 20,925 households (59.2%) - not the test-set figure.",
            "displayFolder": "2 Prevalence"
          },
          {
            "name": "At-risk households (test)",
            "expression": "CALCULATE(SUM(powerbi_households[AtRisk]), powerbi_households[Split] = \"Test\")",
            "lineageTag": "6b3ad0b0-cdca-8e03-fc54-def20dc2b903",
            "formatString": "#,0",
            "displayFolder": "3 What-if"
          },
          {
            "name": "Recall at threshold",
            "expression": "VAR T = [Threshold Value] RETURN DIVIDE(CALCULATE(SUM(powerbi_households[AtRisk]), powerbi_households[Split] = \"Test\", FILTER(ALL(powerbi_households[ModelProbability]), powerbi_households[ModelProbability] >= T)), [At-risk households (test)])",
            "lineageTag": "55ce9473-faeb-8de7-d492-10e12284e203",
            "formatString": "0.0%",
            "description": "At-risk test households referred at the selected threshold.",
            "displayFolder": "3 What-if"
          },
          {
            "name": "Referred at threshold",
            "expression": "VAR T = [Threshold Value] RETURN DIVIDE(CALCULATE(COUNTROWS(powerbi_households), powerbi_households[Split] = \"Test\", FILTER(ALL(powerbi_households[ModelProbability]), powerbi_households[ModelProbability] >= T)), [Test households])",
            "lineageTag": "5114b939-aa10-7f17-1b09-3eacc85ae3de",
            "formatString": "0.0%",
            "displayFolder": "3 What-if"
          },
          {
            "name": "Precision at threshold",
            "expression": "VAR T = [Threshold Value] RETURN DIVIDE(CALCULATE(SUM(powerbi_households[AtRisk]), powerbi_households[Split] = \"Test\", FILTER(ALL(powerbi_households[ModelProbability]), powerbi_households[ModelProbability] >= T)), CALCULATE(COUNTROWS(powerbi_households), powerbi_households[Split] = \"Test\", FILTER(ALL(powerbi_households[ModelProbability]), powerbi_households[ModelProbability] >= T)))",
            "lineageTag": "352e6a9b-c876-9568-672b-27850571af92",
            "formatString": "0.0%",
            "displayFolder": "3 What-if"
          },
          {
            "name": "Households referred (per 1,000)",
            "expression": "ROUND([Referred at threshold] * 1000, 0)",
            "lineageTag": "5e9f390f-66a6-bfd2-76af-fc1659f1eca4",
            "formatString": "#,0",
            "displayFolder": "3 What-if"
          },
          {
            "name": "R at-risk share (weighted)",
            "expression": "VAR p = SELECTEDVALUE(powerbi_households[Province])\nVAR v = IF(ISBLANK(p),\n    LOOKUPVALUE(powerbi_reconciliation[AtRiskPct_weighted], powerbi_reconciliation[Breakdown], \"All\", powerbi_reconciliation[Group], \"All households\"),\n    LOOKUPVALUE(powerbi_reconciliation[AtRiskPct_weighted], powerbi_reconciliation[Breakdown], \"Province\", powerbi_reconciliation[Group], p))\nRETURN DIVIDE(v, 100)",
            "lineageTag": "3bf92561-d51e-dd91-d6b5-3ec6787bc5c6",
            "formatString": "0.0%",
            "description": "The same figure as computed in R, looked up from powerbi_reconciliation.csv.",
            "displayFolder": "4 Reconciliation"
          },
          {
            "name": "R severe share (weighted)",
            "expression": "VAR p = SELECTEDVALUE(powerbi_households[Province])\nVAR v = IF(ISBLANK(p),\n    LOOKUPVALUE(powerbi_reconciliation[SeverePct_weighted], powerbi_reconciliation[Breakdown], \"All\", powerbi_reconciliation[Group], \"All households\"),\n    LOOKUPVALUE(powerbi_reconciliation[SeverePct_weighted], powerbi_reconciliation[Breakdown], \"Province\", powerbi_reconciliation[Group], p))\nRETURN DIVIDE(v, 100)",
            "lineageTag": "4764f2b1-c18a-48f2-07e6-73cfab66d265",
            "formatString": "0.0%",
            "displayFolder": "4 Reconciliation"
          },
          {
            "name": "R referred share",
            "expression": "VAR p = SELECTEDVALUE(powerbi_households[Province])\nVAR v = IF(ISBLANK(p),\n    LOOKUPVALUE(powerbi_reconciliation[ReferredPct], powerbi_reconciliation[Breakdown], \"All\", powerbi_reconciliation[Group], \"All households\"),\n    LOOKUPVALUE(powerbi_reconciliation[ReferredPct], powerbi_reconciliation[Breakdown], \"Province\", powerbi_reconciliation[Group], p))\nRETURN DIVIDE(v, 100)",
            "lineageTag": "2ef1d681-ac3a-a42f-6f35-58e6400d484c",
            "formatString": "0.0%",
            "displayFolder": "4 Reconciliation"
          },
          {
            "name": "Difference at-risk (points)",
            "expression": "ROUND(([At-risk share (weighted)] - [R at-risk share (weighted)]) * 100, 1)",
            "lineageTag": "88b9669c-5c2d-21d8-a701-c0729bb0e357",
            "formatString": "0.0",
            "description": "Dashboard minus R, in percentage points. Must read 0.0 for every province.",
            "displayFolder": "4 Reconciliation"
          },
          {
            "name": "Difference referred (points)",
            "expression": "ROUND(([Referred share] - [R referred share]) * 100, 1)",
            "lineageTag": "cfb6c2a3-a953-4df6-eee7-443620059239",
            "formatString": "0.0",
            "displayFolder": "4 Reconciliation"
          },
          {
            "name": "Reconciliation status",
            "expression": "VAR d = ABS([Difference at-risk (points)]) + ABS([Difference referred (points)])\nRETURN IF(d <= 0.1, \"Reconciled\", \"CHECK\")",
            "lineageTag": "52ae36dc-f910-cf9f-d31b-0300edcc50af",
            "description": "Reconciled when the dashboard and R agree to within 0.1 of a percentage point.",
            "displayFolder": "4 Reconciliation"
          }
        ]
      },
      {
        "name": "powerbi_model_summary",
        "description": "Headline test-set metrics for the deployed screen, as written by the R evaluation notebook.",
