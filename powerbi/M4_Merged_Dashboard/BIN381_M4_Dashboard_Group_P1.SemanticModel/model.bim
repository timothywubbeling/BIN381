              "expression": [
                "let",
                "    Compressed = Binary.FromText(\"\", BinaryEncoding.Base64),",
                "    Source = Csv.Document(Binary.Decompress(Compressed, Compression.GZip), [Delimiter = \",\", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),",
                "    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),",
