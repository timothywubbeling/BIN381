      {
        "name": "Threshold",
        "description": "What-if parameter: the referral threshold a decision-maker can try on the 'How well does the screening tool work?' page. Deployed value 0.24.",
        "lineageTag": "2e57042d-ee67-ee5d-53f7-9dbef62a0562",
        "columns": [
          {
            "name": "Threshold",
            "dataType": "double",
            "type": "calculatedTableColumn",
            "sourceColumn": "[Threshold]",
            "isNameInferred": false,
            "isDataTypeInferred": true,
            "summarizeBy": "none",
            "formatString": "0.00",
            "description": "The referral threshold a decision-maker can try, in steps of 0.01. Built from whole numbers divided by 100 so each value is exactly the number Power BI produces when it is typed into the slicer: GENERATESERIES(0, 1, 0.01) accumulates 0.01 at a time and stores 0.24 as 0.24000000000000007, which drops the 26 test households scoring exactly 0.2400 and makes the what-if cards disagree with the fixed ones.",
            "lineageTag": "32cd3962-57a7-ee09-5fef-731713cdd996",
            "annotations": [
              {
                "name": "SummarizationSetBy",
                "value": "Automatic"
              }
            ]
          }
        ],
        "partitions": [
          {
            "name": "Threshold",
            "mode": "import",
            "source": {
              "type": "calculated",
              "expression": "SELECTCOLUMNS(GENERATESERIES(0, 100, 1), \"Threshold\", [Value] / 100)"
            }
          }
        ],
        "measures": [
          {
            "name": "Threshold Value",
            "expression": "ROUND(SELECTEDVALUE(Threshold[Threshold], 0.24), 2)",
            "lineageTag": "1a00381d-6955-151e-03b9-7c4c515fba95",
            "formatString": "0.00",
            "description": "The threshold currently chosen on the slicer; 0.24 when nothing is selected. Rounded as a safety net, so a typed value that arrives with a floating-point tail still matches a row."
          }
        ]
      }
    ],
