          {
            "name": "Factor",
            "type": "calculated",
            "expression": "SWITCH(powerbi_odds_ratios[Term], \"ComparativeIncomeCode2\", \"Income a little higher than a year ago\", \"ComparativeIncomeCode3\", \"Income about the same\", \"ComparativeIncomeCode4\", \"Income a little lower\", \"ComparativeIncomeCode5\", \"Income much lower\", \"GeoTypeCodeTraditional_Tribal\", \"Traditional / tribal area\", \"GeoTypeCodeFarms\", \"Farm\", \"HouseholdSize\", \"Each extra household member\", \"Income_Log\", \"Higher household income\", \"ElectricityAccessCodeNo\", \"No electricity\", \"SocialGrantRecipients\", \"Each extra grant recipient\", \"MainToiletCode2\", \"Flush toilet, septic tank\", \"MainToiletCode5\", \"Pit latrine with ventilation pipe\", \"MainToiletCode6\", \"Pit latrine, no pipe, with slab\", \"MainToiletCode7\", \"Pit latrine, no pipe, no slab\", \"MainToiletCodeOther\", \"Other toilet type\", powerbi_odds_ratios[Term])",
            "isDataTypeInferred": true,
            "summarizeBy": "none",
            "lineageTag": "64fedb00-8dd0-522d-e91e-60180a929875",
            "annotations": [
              {
                "name": "SummarizationSetBy",
                "value": "Automatic"
              }
            ],
            "dataType": "string"
          },
          {
            "name": "Direction",
            "type": "calculated",
            "expression": "IF(powerbi_odds_ratios[CI_low] > 1, \"Raises risk\", IF(powerbi_odds_ratios[CI_high] < 1, \"Lowers risk\", \"No clear effect\"))",
            "isDataTypeInferred": true,
            "summarizeBy": "none",
            "lineageTag": "13f3fe66-b46f-e8f0-d28c-a153c0415443",
            "annotations": [
