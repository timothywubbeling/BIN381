// FINAL - headline + what-if + tolerance
EVALUATE ROW(
  "Households", [Households in sample], "AtRisk w", [At-risk share (weighted)],
  "Severe w", [Severe share (weighted)], "Referred all", [Referred share],
  "Test hh", [Test households], "Recall@0.24", [Recall at threshold],
  "Precision@0.24", [Precision at threshold], "Referred@0.24", [Referred at threshold],
  "Per1000", [Households referred (per 1,000)], "ThresholdValue", [Threshold Value],
  "Outside tolerance", [Groups outside tolerance], "Status", [Reconciliation status])
--------
// FINAL - slicer default literal still matches exactly one row
EVALUATE ROW("rows matching slicer default",
  COUNTROWS(FILTER('Threshold', ROUND('Threshold'[Threshold], 2) = 0.24)))
--------
// FINAL - province reconciliation, all nine must read 0.0 / Reconciled
EVALUATE
SUMMARIZECOLUMNS(powerbi_households[Province], "Diff at-risk pts",
  [Difference at-risk (points)], "Diff referred pts", [Difference referred (points)],
  "Status", [Reconciliation status])
