                "horizontalTextAlignment": "left"
              },
              {
                "textRuns": [
                  {
                    "value": "Ten extracts were profiled in Milestone 1. The three person-level files could not join one-to-one on the household key and were set aside.",
                    "textStyle": {
                      "fontFamily": "IBM Plex Sans, Segoe UI, system-ui, sans-serif",
                      "fontSize": "9pt",
                      "color": "#D2D0CE"
                    }
                  }
                ],
                "horizontalTextAlignment": "left"
              },
              {
                "textRuns": [
                  {
                    "value": "The seven household-level files joined on HouseholdID to give 20,940 households, after 46 exact duplicate rows were removed.",
                    "textStyle": {
                      "fontFamily": "IBM Plex Sans, Segoe UI, system-ui, sans-serif",
                      "fontSize": "9pt",
                      "color": "#D2D0CE"
                    }
                  }
                ],
                "horizontalTextAlignment": "left"
              },
              {
                "textRuns": [
                  {
                    "value": "Cleaning dropped a further 15, leaving the 20,925 households modelled. The eight food-insecurity items build the target and were held out of the predictors.",
                    "textStyle": {
                      "fontFamily": "IBM Plex Sans, Segoe UI, system-ui, sans-serif",
                      "fontSize": "9pt",
                      "color": "#D2D0CE"
                    }
                  }
                ],
