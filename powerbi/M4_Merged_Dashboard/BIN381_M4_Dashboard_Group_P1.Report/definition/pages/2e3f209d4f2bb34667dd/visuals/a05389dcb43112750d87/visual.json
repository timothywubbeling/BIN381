    "objects": {
      "general": [
        {
          "properties": {
            "paragraphs": [
              {
                "textRuns": [
                  {
                    "value": "How these were treated",
                    "textStyle": {
                      "fontFamily": "IBM Plex Sans, Segoe UI, system-ui, sans-serif",
                      "fontSize": "12pt",
                      "color": "#FFFFFF",
                      "fontWeight": "bold"
                    }
                  }
                ],
                "horizontalTextAlignment": "left"
              },
              {
                "textRuns": [
                  {
                    "value": "",
                    "textStyle": {
                      "fontFamily": "IBM Plex Sans, Segoe UI, system-ui, sans-serif",
                      "fontSize": "6pt",
                      "color": "#979593"
                    }
                  }
                ],
                "horizontalTextAlignment": "left"
              },
              {
                "textRuns": [
                  {
                    "value": "Sentinel codes and text tokens were recoded to missing rather than imputed, so a do-not-know answer never becomes a number the model trusts.",
                    "textStyle": {
                      "fontFamily": "IBM Plex Sans, Segoe UI, system-ui, sans-serif",
                      "fontSize": "9pt",
                      "color": "#D2D0CE"
                    }
                  }
                ],
                "horizontalTextAlignment": "left"
              },
              {
                "textRuns": [
                  {
                    "value": "Duplicate household rows were removed, provinces rebuilt from the clean numeric code, and out-of-range values restricted to their valid set.",
                    "textStyle": {
                      "fontFamily": "IBM Plex Sans, Segoe UI, system-ui, sans-serif",
                      "fontSize": "9pt",
                      "color": "#D2D0CE"
                    }
                  }
                ],
                "horizontalTextAlignment": "left"
              },
              {
                "textRuns": [
                  {
                    "value": "The same rules run in the deployed application, so a household scored in production is cleaned exactly as the training data was.",
                    "textStyle": {
                      "fontFamily": "IBM Plex Sans, Segoe UI, system-ui, sans-serif",
                      "fontSize": "9pt",
                      "color": "#D2D0CE"
                    }
                  }
                ],
                "horizontalTextAlignment": "left"
              },
              {
                "textRuns": [
                  {
                    "value": "Before and After mean different things per row and are never summed.",
                    "textStyle": {
                      "fontFamily": "IBM Plex Sans, Segoe UI, system-ui, sans-serif",
                      "fontSize": "9pt",
                      "color": "#FCB714"
                    }
                  }
                ],
                "horizontalTextAlignment": "left"
              }
            ]
          }
        }
      ]
    },
