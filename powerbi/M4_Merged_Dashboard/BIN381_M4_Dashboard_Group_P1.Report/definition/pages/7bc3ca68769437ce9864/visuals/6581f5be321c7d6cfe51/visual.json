              },
              {
                "textRuns": [
                  {
                    "value": "Every bar is the weighted share of households in that group that are at risk. The national figure is 28.3%.",
                    "textStyle": {
                      "fontFamily": "IBM Plex Sans, Segoe UI, system-ui, sans-serif",
                      "fontSize": "9pt",
                      "color": "#D2D0CE"
                    }
                  }
                ],
                "horizontalTextAlignment": "left"
              },
              {
                "textRuns": [
                  {
                    "value": "The four slicers above apply to all seven charts, so a province can be compared with the country on the same cut.",
                    "textStyle": {
                      "fontFamily": "IBM Plex Sans, Segoe UI, system-ui, sans-serif",
                      "fontSize": "9pt",
                      "color": "#D2D0CE"
                    }
                  }
                ],
                "horizontalTextAlignment": "left"
              },
              {
                "textRuns": [
                  {
                    "value": "These are associations in survey data, not causes, and the target is a proxy built from eight survey items rather than a measured outcome.",
                    "textStyle": {
                      "fontFamily": "IBM Plex Sans, Segoe UI, system-ui, sans-serif",
                      "fontSize": "9pt",
                      "color": "#FCB714"
