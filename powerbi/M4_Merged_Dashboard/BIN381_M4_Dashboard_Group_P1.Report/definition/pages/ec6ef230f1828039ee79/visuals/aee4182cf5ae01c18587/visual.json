              },
              {
                "textRuns": [
                  {
                    "value": "Use the navigator above to move between pages. The four slicers on the household pages - province, settlement type, income band and grant receipt - filter every visual on that page.",
                    "textStyle": {
                      "fontFamily": "IBM Plex Sans, Segoe UI, system-ui, sans-serif",
                      "fontSize": "10pt",
                      "color": "#D2D0CE"
                    }
                  }
                ],
                "horizontalTextAlignment": "left"
              },
              {
                "textRuns": [
                  {
                    "value": "On the bar chart of provinces you can drill down into settlement type. On the performance page you can drag the referral threshold and watch recall, precision and referral volume move together.",
                    "textStyle": {
                      "fontFamily": "IBM Plex Sans, Segoe UI, system-ui, sans-serif",
                      "fontSize": "10pt",
                      "color": "#D2D0CE"
                    }
                  }
                ],
                "horizontalTextAlignment": "left"
              },
              {
                "textRuns": [
                  {
                    "value": "Percentages of the population are weighted with HouseholdWeight. Model performance is always measured on the 6,279 held-out test households.",
                    "textStyle": {
                      "fontFamily": "IBM Plex Sans, Segoe UI, system-ui, sans-serif",
                      "fontSize": "10pt",
                      "color": "#D2D0CE"
                    }
                  }
                ],
