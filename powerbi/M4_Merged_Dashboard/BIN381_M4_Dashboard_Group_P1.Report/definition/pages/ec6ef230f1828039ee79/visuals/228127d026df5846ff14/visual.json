            "paragraphs": [
              {
                "textRuns": [
                  {
                    "value": "About the screen",
                    "textStyle": {
                      "fontFamily": "IBM Plex Sans, Segoe UI, system-ui, sans-serif",
                      "fontSize": "12pt",
                      "color": "#FFFFFF",
                      "fontWeight": "bold"
                    }
                  }
                ],
                "horizontalTextAlignment": "left"
              },
              {
                "textRuns": [
                  {
                    "value": "",
                    "textStyle": {
                      "fontFamily": "IBM Plex Sans, Segoe UI, system-ui, sans-serif",
                      "fontSize": "6pt",
                      "color": "#979593"
                    }
                  }
                ],
                "horizontalTextAlignment": "left"
              },
              {
                "textRuns": [
                  {
                    "value": "A lasso logistic regression scores each household from eight survey answers about income, grants, electricity, sanitation and household size. Households scoring 0.24 or more are referred for follow-up.",
                    "textStyle": {
                      "fontFamily": "IBM Plex Sans, Segoe UI, system-ui, sans-serif",
                      "fontSize": "10pt",
                      "color": "#D2D0CE"
                    }
                  }
                ],
                "horizontalTextAlignment": "left"
              },
              {
                "textRuns": [
                  {
                    "value": "The threshold was chosen to find about 80% of at-risk households. That costs precision: 41.9% of referrals turn out to be at risk, and 58.9% of households are referred.",
                    "textStyle": {
                      "fontFamily": "IBM Plex Sans, Segoe UI, system-ui, sans-serif",
                      "fontSize": "10pt",
                      "color": "#D2D0CE"
                    }
                  }
                ],
                "horizontalTextAlignment": "left"
              },
              {
                "textRuns": [
                  {
                    "value": "This is a screening aid, not an eligibility test. A 'lower risk' score is not clearance, and no household is identifiable from this dashboard.",
                    "textStyle": {
                      "fontFamily": "IBM Plex Sans, Segoe UI, system-ui, sans-serif",
                      "fontSize": "10pt",
                      "color": "#FCB714",
                      "fontWeight": "bold"
                    }
                  }
                ],
                "horizontalTextAlignment": "left"
              }
            ]
          }
        }
      ]
